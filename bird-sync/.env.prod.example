# Copy to .env.prod for real deployment (`just start-prod`) against
# birds.burns.sh, behind the CF Access Service Token policy.
THUMBNAIL_WORKER_URL=https://birds.burns.sh

# Dedicated secret (independent of the Worker's POLL_SECRET) — generate
# with `openssl rand -hex 32`. Must match the Worker's THUMBNAIL_PUSH_SECRET
# (wrangler secret put THUMBNAIL_PUSH_SECRET).
THUMBNAIL_PUSH_SECRET=changeme

THUMBNAIL_POLL_INTERVAL_MINUTES=60

# From Zero Trust > Access > Service Auth > Service Tokens.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
